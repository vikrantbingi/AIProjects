{
  "name": "wingify-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Playwright automation for the Wingify login page",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:headed:login": "playwright test --headed src/tests/login.spec.ts",
    "test:headed:valid": "playwright test --headed src/tests/login.spec.ts --grep \"valid credentials\"",
    "typecheck": "tsc --noEmit",
    "report:allure": "allure generate allure-results --clean --output allure-report",
    "open:allure": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.2",
    "typescript": "^5.9.3"
  }
}
